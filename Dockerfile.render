FROM gosom/google-maps-scraper:v1.18.1

USER root

# Security refresh (2026-10): rebuild the container with the current Debian
# trust store and OpenSSL so HTTPS clients no longer rely on stale CA data.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        openssl \
        python3 \
    && update-ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY render/proxy.py /opt/exporadar/proxy.py
COPY render/enrichment.py /opt/exporadar/enrichment.py
COPY render/start.sh /opt/exporadar/start.sh

RUN chmod +x /opt/exporadar/start.sh

ENTRYPOINT ["/opt/exporadar/start.sh"]
